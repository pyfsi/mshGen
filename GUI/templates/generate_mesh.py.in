'''
generate_mesh.py: mshGen script of case "@NAME@"

Written by the mshGen GUI (GUI/core/writer.py) from case.json on @DATE@.
Do not edit this file: change case.json (or use the GUI) and write the case again.

Writes the blockMesh lists to ./output_files and system/blockMeshDict, from this case's
airfoil file, wing.txt and settings/*.csv.

Usage (from any folder):
    python generate_mesh.py               blockMesh lists + system/blockMeshDict
    python generate_mesh.py --plot        also show mshGen's plots
    python generate_mesh.py --save-plots  also save mshGen's plots to ./images
Set MSHGEN_DIR to the mshGen folder if this case is moved out of the mshGen repository.

Case description:
@DESCRIPTION@
'''

# Imports
import glob
import os
import shutil
import sys
import matplotlib
SAVE_PLOTS = "--save-plots" in sys.argv
PLOT = SAVE_PLOTS or "--plot" in sys.argv
if SAVE_PLOTS or not PLOT:
    matplotlib.use("Agg")
from matplotlib import pyplot as plt

# Locations: this case and the mshGen repository
case_dir = os.path.dirname(os.path.abspath(__file__))
mshgen_dir = os.path.abspath(os.environ.get("MSHGEN_DIR", os.path.join(case_dir, @MSHGEN_RELPATH@)))
if os.path.basename(mshgen_dir) != "mshGen" or not os.path.isdir(os.path.join(mshgen_dir, "meshGeneration")):
    sys.exit("mshGen not found at " + mshgen_dir + ": set MSHGEN_DIR to the mshGen folder")
sys.path.insert(0, os.path.dirname(mshgen_dir))
from mshGen.meshGeneration.mesh_class import Mesh

plt.close("all")

# ---------------------- Case settings (from case.json) ---------------------- #

# Airfoil
airfoil_name = @AIRFOIL_NAME@
filename1 = os.path.join(case_dir, @AIRFOIL_FILE@)

# Wing
wing_name = @WING_NAME@
filename2 = @WING_FILE@

# Case dimension and mesh origin (COG)
dim = @DIM@
COG = @COG@

# Domain and blocks
mesh_scale = @MESH_SCALE@
mesh_level = @MESH_LEVEL@
slice_locations = @SLICE_LOCATIONS@
layer_resolution = @LAYER_RESOLUTION@
layer_grading = @LAYER_GRADING@
layer_aileron = @LAYER_AILERON@
skip_layer = @SKIP_LAYER@

# Settings files (vertex positions, edge resolution and grading) and output folder
foldername1 = os.path.join(case_dir, "settings")
foldername2 = os.path.join(case_dir, "output_files")

# Flags
WRITE = True
PRINT = True
DEFAULT = False         # always read the settings files of this case
SPLIT = @SPLIT@
ARTIFICIOUS = @ARTIFICIOUS@

# ---------------------- Create blockMesh lists ---------------------- #

# Start from an empty output folder (no lists left over from earlier settings)
shutil.rmtree(foldername2, ignore_errors=True)
os.makedirs(foldername2)

casename = airfoil_name+"_"+dim+"_"+wing_name+"_R"+"{:05.0f}".format(1e2*mesh_scale)+"C_"+mesh_level
names = [casename, airfoil_name, wing_name]
files = [filename1, filename2, foldername1, foldername2]
params = [dim, COG, slice_locations, layer_resolution, layer_grading, layer_aileron, mesh_scale, mesh_level, skip_layer]
flags = [WRITE, PRINT, PLOT, DEFAULT, SPLIT, ARTIFICIOUS]

mesh = Mesh(names, files, params, flags)
mesh.initialize_mesh()
mesh.generate_default()
mesh.generate_vertices()
mesh.generate_blocks()
mesh.generate_edges()
mesh.generate_interfaces()
mesh.generate_boundaries()

# ---------------------- Write system/blockMeshDict ---------------------- #

def write_blockMeshDict(mesh):
    '''blockMeshDict including exactly the lists written above.'''
    def include(names):
        return "".join('    #include "../output_files/' + n + '"\n' for n in names)
    boundaries = sorted(os.path.basename(f) for f in glob.glob(os.path.join(foldername2, "list_boundaries_*")))
    interfaces = "list_boundaries_leftInterface" in boundaries
    text = ("FoamFile { version 2.0; format ascii; class dictionary; object blockMeshDict; }\n"
            "// Case " + @NAME_LITERAL@ + ": written by generate_mesh.py (mshGen GUI)\n\n"
            "scale 1;\n\n"
            "vertices\n(\n" + include("list_vertices_slice" + str(k) for k in range(mesh.N_slices)) + ");\n\n"
            "blocks\n(\n" + include("list_blocks_layer" + str(k) for k in range(mesh.N_layers)) + ");\n\n"
            "edges\n(\n" + include("list_edges_slice" + str(k) for k in range(mesh.N_slices)) + ");\n\n"
            "boundary\n(\n" + include(boundaries) + ");\n\n"
            "mergePatchPairs\n(\n" + ("    (leftInterface rightInterface)\n" if interfaces else "") + ");\n")
    os.makedirs(os.path.join(case_dir, "system"), exist_ok=True)
    with open(os.path.join(case_dir, "system", "blockMeshDict"), "w") as f:
        f.write(text)
    print("Written system/blockMeshDict")

write_blockMeshDict(mesh)

# ---------------------- Plots ---------------------- #
if SAVE_PLOTS:
    os.makedirs(os.path.join(case_dir, "images"), exist_ok=True)
    for num in plt.get_fignums():
        fig = plt.figure(num)
        fig.set_size_inches(16, 9)
        name = os.path.join(case_dir, "images", "mshgen_fig{:02d}.png".format(num))
        fig.savefig(name, dpi=120, bbox_inches="tight")
        print("Written " + os.path.relpath(name, case_dir))
elif PLOT:
    plt.show()

print("END")
